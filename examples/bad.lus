    -- a = 3.1 +. 2.0;
    -- a = 1 < 2;
    a = -2;
tel;

node undef() returns (a, b: int);
var c: real;
let
    (a, b) = (3+3, 5+5);    -- comment one of these
    c = -. 5.3;
tel;

node sum(a: real; b: int) returns (c: int);
let
    c = int_of_real(a) + b;
tel;

node redef(a: int) returns (b: int);
-- var a: real;
let
    b = a;
tel;

