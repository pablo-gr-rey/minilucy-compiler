node call(a: real; b: int) returns (y: int);
var c: bool;
let
    -- c = sum(b, a);
    -- c = sum(a, b);
    c = true and false;
    y = sum(a, b);
tel;

node bad_call() returns (y: int);
let
    -- y = magic();
    y = 1;
tel;

node bad_if(a: int; b: real; c: bool) returns (y: int);
var d: bool;
let
    -- y = if c then a else b;
    -- y = if c then real_of_int(a) else b;
    -- y = if a then a else b;
    (y, d) = if (c and not c) then (a, true) else (int_of_real(b), false);
tel;

node bad_merge(a: int; b: real; c: bool) returns (y: int);
var d: bool;
let
    -- y = merge c (true -> a) (false -> b);
    -- y = merge c (true -> real_of_int(a)) (false -> b);
    -- y = merge a (true -> a) (false -> a+1);
    -- y = merge (c and c) (true -> a) (false -> a+1);
    -- y = merge c (true -> a) (true -> a+1);
    (y, d) = merge c (false -> (a, true)) (true -> (int_of_real(b), false));
tel;
