node test2(a, b: int) returns (c, d: int);
let
   (c, d) = if a < b then (a, b) else (b, a);
tel;

node example(x: int; c: bool) returns (y: int);
let
    y = x;
tel

node test0(a, b: int) returns (c, d: int);
let
--    (c, d) = if true then test2 (pre a, pre b) else test2 (a, b);
    (c, d) = test2 (pre a, pre b);
tel;

node testA(a, b: int) returns (c, d: int);
let
    (c, d) = (a, b) fby (a, b);
tel;

node alt() returns (a: bool);
let
    a = false fby not (pre a);
tel

node bad() returns (a: bool);
var e: bool; f: bool when e;
let
    a = true;
    f = false when e;
    e = true;
tel;

node testB(a, b: bool) returns (c, d: bool; x: int; y: int);
var e: bool when a; g: bool when a; f: int when not a;
let
    c = a and b;
    d = if alt() then false else true;
    y = if alt() then 4 else 1;
    -- (e, f) = if a then (b when a, 1) else (false when a, 3);
    -- (e, f) = if true then (b when a, 1) else (false,
    g = false; 
    e = merge g (true -> ((true when a) when g)) (false -> ((false when a) when not g));
    f = 4 when not a;
    -- (e, f) = merge d (true -> ((true when a) when d, (y when not a) when d)) (false -> ((false when a) when not d, ((y when not a) + 1) when not d)) ;
    x = merge a (true -> 2) (false -> f);
tel;

