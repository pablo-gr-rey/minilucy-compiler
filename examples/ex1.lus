node count(a: bool) returns (s: int);
let
    s = (0 -> pre s) + (if a then 1 else 0);
tel;

node count_2(a: bool) returns (s1, s2: int);
let
   s1 = count(a);
   s2 = count(not a);
tel;

node regulator (cruise_speed, speed : real; rst : bool)
returns (throttle : real);
var delta, aux : real;
let
delta = cruise_speed - speed;
throttle = delta * 10.0 + aux * 0.2;
aux = if rst then delta else delta + pre aux;
tel
