node count() returns (a: int);
let
   a = 0 -> 1 + pre a;
tel;

node idiot() returns (a: int);
let
    a = 3;
tel;

node count_tick(tick: bool) returns (a: int);
let
   a = 0 -> 1 + pre a;
tel;

node nomem(a, b: int) returns (c: int);
let
    c = a + b;
tel;

node test(a: bool) returns (s1, s2, s3: int);
let
    s1 = if a then count() else count();
    s2 = merge a (true -> count() when a) (false -> count() when not a);
    s3 = merge a (true -> count_tick(true when a)) (false -> count_tick(true when not a));
tel;

node test2(a: bool) returns (s1, s2: int);
var tmp1: int when a; tmp2: int when not a;
let
    tmp1 = count() when a;
    tmp2 = count() when not a;
    s1 = merge a (true -> tmp1) (false -> tmp2);
    s2 = merge a (true -> count() when a) (false -> count() when not a);
tel;

node test_real(a, b: real) returns (c: real);
let
   c = a + b * a + b;
tel;

node proc0 (cpu : bool)
returns (pc : int; asks_cs0: bool);
var asks_cs0_vstate : bool;
let
    pc = if cpu then 3 else 10;
    asks_cs0_vstate = false fby (1 <= pc and pc < 6);
    asks_cs0 = asks_cs0_vstate;
tel;

node real_fail() returns (r: real);
let
    r = 5.0 fby (10000000000001.0 * r - 10000000000000.0 * r + 1.0);
tel;
